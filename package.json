{
  "name": "limaz-expense-policy",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant expense policy service - LIMAZ Software Engineer Assessment",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "dev:api": "npm run dev --workspace @limaz/api",
    "dev:web": "npm run dev --workspace @limaz/web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
