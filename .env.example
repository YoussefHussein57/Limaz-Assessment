# =============================================================================
# LIMAZ Expense Policy Service - environment template
# -----------------------------------------------------------------------------
# Copy to `.env` before running `docker compose up`:
#     cp .env.example .env
#
# Every value below is a DEVELOPMENT-ONLY placeholder. None of these are, or
# have ever been, real credentials. Production values must be supplied by the
# deployment platform's secret store and must never be committed.
# =============================================================================

# ---- runtime ----
NODE_ENV=development

# ---- postgres (compose service `db`) ----
POSTGRES_USER=limaz
POSTGRES_PASSWORD=limaz_dev_only_password
POSTGRES_DB=limaz

# Host port for the database. 5433 (not 5432) so it never collides with a
# PostgreSQL instance already installed on the reviewer's machine.
DB_PORT=5433

# ---- api (compose service `api`) ----
API_PORT=3001

# Used by the API process. Inside Docker the host is the service name `db`.
# When running the API on the host against the dockerised database, use:
#     postgresql://limaz:limaz_dev_only_password@localhost:5433/limaz?schema=public
DATABASE_URL=postgresql://limaz:limaz_dev_only_password@db:5432/limaz?schema=public

# ---- web (compose service `web`) ----
WEB_PORT=3000

# Server-side only. The Next.js server proxies /api/* here so that the browser
# only ever talks to the web origin (same-origin deployment, see ADR-008).
# This is NEVER exposed to the browser - it has no NEXT_PUBLIC_ prefix.
INTERNAL_API_URL=http://api:3001

# ---- database connection pool ----
# Maximum connections held by the API's pg pool.
#
# This must stay ABOVE the concurrency used by any concurrency test. With a
# pool of 1, "simultaneous" requests queue inside the pool and run one after
# another, so a concurrency test would pass without ever exercising the
# database-level serialisation it claims to prove (risk R-10).
DB_POOL_MAX=10

# ---- authentication (F02) ----

# The browser origin the API expects. A request that carries an Origin header
# which does not match this is rejected, which stops a cross-origin page from
# driving the API even if the browser's own CORS rules were somehow bypassed.
# Requests with NO Origin header (server-to-server API key callers) are not
# affected, because such clients never send one.
APP_ORIGIN=http://localhost:3000

# Absolute session lifetime. Enforced in the database query, not only in the
# cookie, because the cookie is under the client's control.
SESSION_TTL_HOURS=8

# Secure cookies in EVERY environment, including development: Chrome and
# Firefox both treat http://localhost as a secure context. Making this differ
# between dev and prod is how security bugs end up production-only.
COOKIE_SECURE=true

# bcrypt work factor for passwords. Deliberately slow, because passwords have
# low entropy. Session tokens and API keys use SHA-256 instead - they carry 256
# bits of entropy, so slow hashing buys nothing and makes lookup impossible.
BCRYPT_COST=10

# ---- development seed gate ----
# The seed rewrites credentials that are published in this repository, and
# resets revoked API keys to ACTIVE. It therefore refuses to run unless this is
# explicitly "true". Keep it out of any real deployment.
SEED_DEV_DATA=true
