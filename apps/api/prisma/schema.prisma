// =============================================================================
// LIMAZ Expense Policy Service - database schema
//
// Design notes, alternatives and failure modes live in docs/adr/ and
// docs/features/F01-database-and-seed.md. This file carries only the comments
// that explain a line you would otherwise read as a mistake.
//
// In Prisma 7 the datasource carries no `url`: the CLI reads it from
// prisma.config.ts and the runtime client receives a driver adapter.
// See docs/adr/ADR-009-prisma-7-driver-adapter.md.
//
// CHECK constraints are NOT expressible in the Prisma schema language. Four of
// them are appended by hand to the init migration and are listed in
// docs/features/F01-database-and-seed.md. They are load-bearing, not cosmetic.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  MANAGER
  PLATFORM_ADMIN
}

enum ApiKeyStatus {
  ACTIVE
  ROTATING // superseded by a newer key, still valid until expiresAt
  REVOKED
}

/// What the policy engine concluded at submission time. Never changes.
enum ExpenseDecision {
  APPROVE
  REVIEW
  REJECT
}

/// The expense's final outcome. Changes at most once, when a review resolves.
enum ExpenseStatus {
  APPROVED
  REJECTED
  PENDING_REVIEW
}

enum ReviewState {
  OPEN
  RESOLVED
}

enum ReviewOutcome {
  APPROVED
  REJECTED
}

enum RuleCode {
  AMOUNT_LIMIT
  FREQUENCY
  BLOCKED_CATEGORY
}

/// Where an expense came from (F12).
///
/// This is NOT decoration. It is half of the idempotency key, because the two
/// sources name their expenses from different authorities: a company's backend
/// chooses its own externalId, and the card provider's transactionId is chosen
/// by somebody that backend has never spoken to. Without a source the two
/// namespaces would share one unique constraint, and an ordinary client could
/// pick an externalId that collides with a future card transaction - a prefix
/// convention cannot prevent that, because the client picks the whole string.
///
/// A second card provider would be a third value here, not a parsing rule.
enum ExpenseSource {
  API
  CARD_WEBHOOK
}

/// The lifecycle of one accepted webhook delivery (F12).
enum WebhookEventStatus {
  /// Durably accepted, waiting for a worker.
  PENDING
  /// Claimed by a worker. A claim older than the lease is recoverable.
  PROCESSING
  /// An expense exists for it. Terminal.
  PROCESSED
  /// A supported event we will not retry. Terminal.
  FAILED
  /// A valid, authenticated event whose type this system does not handle.
  /// Terminal, and deliberately NOT an error: the provider retries until it
  /// gets a 2xx, so refusing forever would be an infinite retry loop.
  IGNORED
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

model Company {
  id       String @id @default(uuid(7)) @db.Uuid
  name     String
  /// ISO-4217. One currency per company (assumption A3): an expense in any
  /// other currency is rejected rather than converted.
  currency String @db.VarChar(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  policy   Policy?
  users    User[]
  apiKeys  ApiKey[]
  expenses Expense[]

  webhookIntegration WebhookIntegration?
  webhookEvents      WebhookEvent[]

  @@map("companies")
}

/// One row per company - the `@unique` on companyId is what makes this
/// one-to-one rather than one-to-many.
///
/// Separate from Company because policy settings are edited from the manager
/// dashboard while the company record is not, so the two have different write
/// paths and different audit meaning.
model Policy {
  id        String @id @default(uuid(7)) @db.Uuid
  companyId String @unique @db.Uuid

  /// Minor units, consistent with Expense.amountMinor (ADR-005).
  autoApproveLimitMinor  Int
  frequencyMaxCount      Int      @default(3)
  frequencyWindowMinutes Int      @default(60)
  /// Normalised uppercase. A Postgres text[] rather than a join table: the
  /// list is short, read whole, and never queried from the other direction.
  blockedCategories      String[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("policies")
}

// -----------------------------------------------------------------------------
// People and credentials
// -----------------------------------------------------------------------------

/// companyId is nullable because the platform admin belongs to no company.
///
/// That nullability is dangerous on its own: a MANAGER with a null companyId
/// would make every tenant filter read `WHERE company_id = NULL`, which in SQL
/// matches nothing - or, in carelessly written code, is dropped entirely. A
/// CHECK constraint in the init migration makes that row impossible.
model User {
  id        String  @id @default(uuid(7)) @db.Uuid
  companyId String? @db.Uuid

  /// Globally unique, not per company. Login is email plus password with no
  /// company selector, so the email must identify exactly one user.
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company         Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  sessions        Session[]
  resolvedReviews Review[]

  @@index([companyId])
  @@map("users")
}

/// Database-backed sessions rather than stateless JWTs, because a JWT cannot be
/// revoked and logout, password change and admin access management all need
/// revocation (ADR-008).
///
/// Only the SHA-256 hash of the token is stored. A database dump yields hashes,
/// not usable sessions.
model Session {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Supports "revoke every session for this user".
  @@index([userId])
  @@map("sessions")
}

/// Only the SHA-256 hash is stored; the plaintext is shown exactly once, at
/// creation or rotation (ADR-006).
model ApiKey {
  id        String @id @default(uuid(7)) @db.Uuid
  companyId String @db.Uuid

  keyHash String @unique
  /// First few characters of the key, for display and support only. It takes
  /// no part in authentication.
  prefix  String

  status    ApiKeyStatus @default(ACTIVE)
  /// Null means no expiry. During rotation the superseded key gets a value.
  expiresAt DateTime?    @db.Timestamptz(3)
  revokedAt DateTime?    @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("api_keys")
}

// -----------------------------------------------------------------------------
// Expenses
// -----------------------------------------------------------------------------

model Expense {
  id        String @id @default(uuid(7)) @db.Uuid
  companyId String @db.Uuid

  /// The caller's own identifier for this expense.
  ///
  /// For `source = API` it is the `externalId` the company's backend supplied.
  /// For `source = CARD_WEBHOOK` it is the provider's `transactionId` - not
  /// the event id, because the assessment's guarantee is that each
  /// TRANSACTION becomes exactly one expense, and a provider may legitimately
  /// deliver two different events about the same payment.
  ///
  /// Unique per (company, source), not globally and not per company alone.
  /// See the `ExpenseSource` comment for why the source belongs in the key.
  externalId String
  /// Where this expense entered the system. See `ExpenseSource`.
  source     ExpenseSource @default(API)
  employeeId String

  /// Minor units as an integer (ADR-005). Never a float: binary floating point
  /// cannot represent most decimal fractions, and the error shows up as money.
  amountMinor Int
  currency    String @db.VarChar(3)
  merchant    String
  /// Normalised uppercase before storage, so blocked-list matching is exact.
  category    String

  /// When the money was spent. The frequency window is measured on this, not
  /// on arrival time (ADR-002).
  spentAt    DateTime @db.Timestamptz(3)
  /// When we received it. Stored so the gap to spentAt is always auditable.
  receivedAt DateTime @default(now()) @db.Timestamptz(3)

  decision ExpenseDecision
  status   ExpenseStatus

  /// SHA-256 over the canonicalised business fields. Distinguishes a genuine
  /// retry from a conflicting resubmission of the same externalId (ADR-001).
  payloadHash String

  /// The policy settings this expense was judged against, captured at decision
  /// time (assumption A7). Editing a policy never re-evaluates history, so
  /// without this snapshot "why was this approved?" becomes unanswerable.
  policySnapshot Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  ruleHits RuleHit[]
  review   Review?

  /// Tenant-scoped idempotency. The database is the authority: a check-then-
  /// insert in application code loses the race when two retries arrive
  /// together (ADR-001, risk R-03).
  ///
  /// `source` joined the key in F12 and does NOT weaken it. For an ordinary
  /// caller the source is always `API`, so `(companyId, 'API', externalId)` is
  /// exactly as unique as `(companyId, externalId)` was: a company's backend
  /// still cannot create two expenses with one identifier. What the source
  /// adds is a second namespace that the first one cannot be made to collide
  /// with, deliberately or by accident.
  @@unique([companyId, source, externalId])
  /// Looks redundant because `id` is already unique - it is not. Postgres
  /// requires a UNIQUE on exactly the referenced columns for them to be the
  /// target of a foreign key. This is what lets Review reference
  /// (id, companyId) together, so a review's tenant can never drift from its
  /// expense's tenant.
  @@unique([id, companyId])
  /// The frequency query: company + employee + a spentAt range. Column order
  /// matters - the range column must come last for this to be a range scan
  /// (ADR-007).
  @@index([companyId, employeeId, spentAt])
  /// The manager dashboard: a company's expenses, most recent first. The index
  /// above cannot serve this, because employeeId sits between the two columns
  /// this query uses.
  @@index([companyId, spentAt])
  @@map("expenses")
}

/// One row per rule that fired. The API response lists every reason, not only
/// the one that produced the winning decision.
model RuleHit {
  id        String @id @default(uuid(7)) @db.Uuid
  expenseId String @db.Uuid

  ruleCode RuleCode
  /// What this individual rule concluded, before precedence was applied.
  decision ExpenseDecision
  /// Rule-specific evidence, for example the limit and the amount, or the
  /// window, the count and the maximum.
  detail   Json

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// A rule fires at most once per expense.
  @@unique([expenseId, ruleCode])
  @@map("rule_hits")
}

/// Opened only for a REVIEW decision (assumption A8), at most one per expense.
///
/// companyId is denormalised from the expense so the tenant guard and the
/// concurrency guard can sit in the same WHERE clause of a single conditional
/// UPDATE (assumption A9, ADR-004). Checking the tenant in a separate
/// statement would open a time-of-check-to-time-of-use gap.
///
/// The composite relation below is what makes that denormalisation safe:
/// (expenseId, companyId) is a foreign key onto Expense(id, companyId), so a
/// review whose companyId differs from its expense's is rejected by the
/// database. There is deliberately no second foreign key to Company - the
/// reference is already transitively guaranteed through the expense.
model Review {
  id        String @id @default(uuid(7)) @db.Uuid
  expenseId String @unique @db.Uuid
  companyId String @db.Uuid

  state   ReviewState    @default(OPEN)
  /// All three resolution fields are null while OPEN and all three are set
  /// when RESOLVED. A CHECK constraint enforces that, so a resolved review
  /// with no recorded reviewer cannot exist.
  outcome ReviewOutcome?

  resolvedByUserId String?   @db.Uuid
  resolvedAt       DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  expense    Expense @relation(fields: [expenseId, companyId], references: [id, companyId], onDelete: Restrict)
  resolvedBy User?   @relation(fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  /// Required by Prisma so the composite relation above can be one-to-one.
  /// It is implied by the `@unique` on expenseId - which is kept, because
  /// "one review per expense" should be stated directly rather than inferred
  /// from a two-column constraint plus the composite foreign key.
  @@unique([expenseId, companyId])
  /// The manager's primary query: this company's open reviews.
  @@index([companyId, state])
  @@map("reviews")
}

// -----------------------------------------------------------------------------
// Card webhook intake (F12 - the assessment's optional bonus, section 10)
// -----------------------------------------------------------------------------

/// One company's card-provider integration.
///
/// ---------------------------------------------------------------------------
/// WHY THIS SECRET IS ENCRYPTED AND NOT HASHED, UNLIKE EVERY OTHER CREDENTIAL
/// ---------------------------------------------------------------------------
///
/// `ApiKey` and `Session` store only a SHA-256 hash, and that is the right
/// answer for both: the server is handed the full credential and only has to
/// decide whether it matches, so a one-way function is enough and a database
/// dump yields nothing usable.
///
/// HMAC is a different problem. The provider never sends the secret - it
/// sends a MAC computed WITH the secret, and verifying it means computing the
/// same MAC on our side. That needs the key material itself. A hash cannot
/// produce it, and "HMAC with the hash as the key" is not the protocol the
/// provider implements, so it would simply never verify.
///
/// So the secret is stored reversibly, and the question becomes who can
/// reverse it. AES-256-GCM with a key that lives in configuration rather than
/// in the database: a stolen dump is inert without `WEBHOOK_ENCRYPTION_KEY`,
/// and GCM is authenticated, so a tampered ciphertext fails to decrypt rather
/// than silently yielding a different key.
///
/// This is weaker than hashing, unavoidably, and it is recorded as such
/// (R-35) rather than presented as equivalent.
model WebhookIntegration {
  id        String @id @default(uuid(7)) @db.Uuid
  /// One integration per company - `@unique` is what makes this one-to-one.
  companyId String @unique @db.Uuid

  /// The identifier the provider sends in a header so we know WHICH secret to
  /// verify against.
  ///
  /// It is PUBLIC and it is UNTRUSTED. Knowing it grants nothing: it only
  /// selects a row, and the signature computed with that row's secret is what
  /// decides whether the request is genuine. An attacker who names another
  /// company's delivery id is verified against that company's secret, which
  /// they do not have, and is refused.
  deliveryId String @unique

  /// AES-256-GCM. Three columns because GCM needs all three to decrypt, and
  /// splitting them makes it impossible to store one without the others.
  secretCiphertext Bytes
  secretIv         Bytes
  secretAuthTag    Bytes

  /// How many times the signing secret has been replaced. Shown to an
  /// administrator so "did my rotation land?" is answerable without a secret
  /// ever being displayed again.
  secretVersion Int @default(1)

  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  rotatedAt DateTime? @db.Timestamptz(3)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("webhook_integrations")
}

/// The durable inbox: one row per ACCEPTED delivery.
///
/// ---------------------------------------------------------------------------
/// WHY A TABLE AND NOT A QUEUE PROCESS
/// ---------------------------------------------------------------------------
///
/// The provider retries until it gets a 2xx, so a 2xx is a PROMISE that the
/// event will be processed. An in-memory queue cannot keep that promise: the
/// process restarts and the event is gone, while the provider has already
/// been told it landed and will never send it again.
///
/// Redis or RabbitMQ would keep it, at the cost of a second piece of
/// infrastructure in a system whose whole deployment is one
/// `docker compose up`. PostgreSQL is already here, already transactional,
/// and `FOR UPDATE SKIP LOCKED` is a queue claim that two workers cannot both
/// win. The trade-off - polling rather than push, and one database doing two
/// jobs - is real and is written down in the README.
///
/// NOTHING RESEMBLING A CARD NUMBER IS STORED. The provider's event carries a
/// cardholder reference, a merchant and an amount; there is no PAN, no expiry
/// and no CVV in the contract, and none is persisted.
model WebhookEvent {
  id String @id @default(uuid(7)) @db.Uuid

  /// The company this event was AUTHENTICATED as, never the one the body
  /// claimed. It is written from the integration whose secret verified the
  /// signature.
  companyId String @db.Uuid

  /// The provider's own event id, for example `evt_8f2c1`.
  providerEventId String
  eventType       String

  /// SHA-256 over the event type and its canonical business payload.
  ///
  /// It deliberately EXCLUDES the delivery timestamp and the signature. A
  /// legitimate replay of the same event is signed afresh, so its signature
  /// headers differ while the payment it describes has not changed; folding
  /// those into the identity would make every retry look like a new event.
  payloadHash String

  /// The event's business payload, as accepted. Kept for auditing: "why did
  /// this expense say 420.00?" is otherwise unanswerable once the provider's
  /// own logs roll over.
  payload Json

  status   WebhookEventStatus @default(PENDING)
  /// How many times a worker has CLAIMED this event. Bounded; see the worker.
  attempts Int                @default(0)

  receivedAt    DateTime  @default(now()) @db.Timestamptz(3)
  /// Not before this instant. Backoff is a value in this column, not a sleep
  /// in a process that a restart would forget.
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  /// When the current worker claimed it. A claim older than the lease is
  /// taken to belong to a worker that died, and may be reclaimed.
  claimedAt     DateTime? @db.Timestamptz(3)
  processedAt   DateTime? @db.Timestamptz(3)

  /// The expense this event produced, once it has one.
  ///
  /// No foreign key, deliberately. The relation is informational, and a
  /// RESTRICT here would mean an event row could block an expense from ever
  /// being removed - a coupling the inbox has no business creating.
  expenseId String? @db.Uuid

  /// A SANITISED reason, never a raw exception. Exception text carries
  /// connection strings, parameter values and sometimes credentials, and this
  /// column is rendered in an administrator's browser.
  lastError String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// DELIVERY deduplication, scoped to the company that was authenticated.
  ///
  /// This is a different guarantee from expense idempotency and both are
  /// needed. This one stops a redelivered event from being processed twice;
  /// the expense unique constraint stops two different events about one
  /// transaction from creating two expenses. Neither subsumes the other.
  ///
  /// Scoped per company, so two companies whose providers happen to use the
  /// same event id counter remain independent.
  @@unique([companyId, providerEventId])
  /// The worker's claim query: the oldest due row. Partial would be tighter,
  /// but Prisma cannot express one and the table is small by construction.
  @@index([status, nextAttemptAt])
  /// The administrator's listing: one company's events, newest first.
  @@index([companyId, receivedAt])
  @@map("webhook_events")
}
