{
  "name": "@limaz/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS backend for the LIMAZ multi-tenant expense policy service",
  "scripts": {
    "build": "prisma generate && nest build && tsc -p tsconfig.seed.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.11",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15"
  }
}
