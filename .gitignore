# ---- dependencies ----
node_modules/
.pnp
.pnp.js

# ---- build output ----
dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# ---- environment & secrets ----
# NEVER commit real environment files. .env.example is the only one tracked.
.env
.env.*
!.env.example

# ---- test & coverage output ----
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ---- logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- local/temporary ----
tmp/
temp/
*.local
.cache/

# ---- IDE & OS artifacts ----
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- docker local overrides ----
docker-compose.override.yml

# ---- prisma local artifacts ----
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# ---- agent tooling installed into the workspace ----
# Not part of this project. These appear when a Claude Code skill or agent is
# installed locally; committing them would put third-party files in the
# submission that nobody could justify (risk R-13).
.claude/
.agents/
skills-lock.json
